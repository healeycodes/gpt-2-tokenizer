#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path

try:
    import regex
except ImportError:
    raise SystemExit("run: .venv/bin/pip install regex")


ROOT = Path(__file__).resolve().parent.parent
INPUTS = ROOT / "inputs"
def reference():
    sys.path.insert(0, str(ROOT / "scratch"))
    import encoder

    with open(ROOT / "assets/encoder.json") as file:
        vocabulary = json.load(file)
    with open(ROOT / "assets/vocab.bpe", encoding="utf-8") as file:
        merges = [tuple(line.split()) for line in file.read().splitlines()[1:-1]]
    return encoder.Encoder(vocabulary, merges)


def rust_tokens(path, options):
    output = subprocess.check_output(
        [ROOT / "target/debug/gpt2-tokenizer", *options, path],
        text=True,
    )
    return json.loads(output)


def main():
    options = [item for item in sys.argv[1:] if item.startswith("--")]
    expected = reference()
    for path in sorted(INPUTS.iterdir()):
        if path.suffix not in {".txt", ".js", ".json", ".log"}:
            continue
        actual = rust_tokens(path, options)
        assert actual == expected.encode(path.read_text()), path.name
        print(f"{path.name}: {len(actual)} tokens")


main()
